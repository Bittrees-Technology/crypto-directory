{
  "git": {
    "deploymentEnabled": {
      "directory-intake": false
    }
  },
  "rewrites": [
    {
      "source": "/api/integrations/mcp",
      "destination": "/api/editorial-mcp"
    },
    {
      "source": "/api/directory/:path*",
      "destination": "/api/directory"
    },
    {
      "source": "/sign-in",
      "destination": "/sign-in.html"
    },
    {
      "source": "/administration",
      "destination": "/api/project-admin"
    },
    {
      "source": "/administration/",
      "destination": "/api/project-admin"
    },
    {
      "source": "/api/project-admin/:path*",
      "destination": "/api/project-admin"
    },
    {
      "source": "/api/shared-roles-health",
      "destination": "/api/project-admin"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
