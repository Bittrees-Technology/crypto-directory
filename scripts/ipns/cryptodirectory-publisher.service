[Unit]
Description=Verify and publish the queued CryptoDirectory IPNS release
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/raging/.local/lib/cryptodirectory-publisher/publisher.py --state-dir /home/raging/.local/state/cryptodirectory-publisher --publish
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
